{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "github:igorovh/opencode-better-worktrees#v0.2.0",
      "options": {
        // Omit to let OpenCode choose its per-project worktree location.
        // Relative paths resolve against the project directory.
        "directoryRoot": "../.worktrees",
        // Suggested work branch: "<branchPrefix><name>".
        "branchPrefix": "agent/",
        // Add the short worktree usage policy to the agent's context.
        "instructions": true
      }
    }
  ]
}
